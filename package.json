{
  "name": "bb-plugin-agent-tools",
  "version": "0.2.17",
  "description": "One inventory of MCP servers and agent skills across every BB machine: what is connected where, what is missing, a single skills canon with fan-out, sync and a version archive.",
  "license": "MIT",
  "author": "Kirill Vechkasov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VKirill/bb-plugin-agent-tools.git"
  },
  "homepage": "https://github.com/VKirill/bb-plugin-agent-tools#readme",
  "keywords": [
    "bb",
    "bb-plugin",
    "mcp",
    "agent-skills",
    "claude-code",
    "codex",
    "opencode"
  ],
  "type": "module",
  "engines": {
    "bb": ">=0.43",
    "bbPluginSdk": ">=0.4.87"
  },
  "bb": {
    "name": "Agent Tools",
    "description": "Compare MCP servers and agent skills across BB machines, then sync a shared catalogue and skills canon.",
